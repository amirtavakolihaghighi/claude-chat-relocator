# Normalise line endings so the repository is identical on every platform.
# Without this, cloning on Windows can give start.sh CRLF endings, which makes
# Linux and macOS refuse to run it ("bad interpreter").
* text=auto eol=lf

# Windows-only scripts genuinely need CRLF.
*.cmd  text eol=crlf
*.bat  text eol=crlf

# Shell scripts must always be LF, whatever the platform.
*.sh   text eol=lf

# Never touch binaries.
*.png  binary
*.jpg  binary
*.gif  binary
*.ico  binary
*.zip  binary
*.exe  binary
*.woff binary
*.woff2 binary

# Keep generated noise out of diffs and language statistics.
package-lock.json  -diff linguist-generated
