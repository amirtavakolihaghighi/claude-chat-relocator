# dependencies
node_modules/

# logs
*.log
npm-debug.log*

# build output
dist/
build/
*.exe
*.blob

# editors
.vscode/
# ...but the extension's F5 config is part of the project
!extension/.vscode/
!extension/.vscode/launch.json
.idea/
*.swp
.DS_Store
Thumbs.db

# runtime data written by the app (backups, history, staged uploads)
.claude-chat-relocator/

# local scratch
tmp/
scratch/

# extension: lib/ is copied from server/ at package time, .vsix is a build artefact
extension/lib/
*.vsix

# your own chat data, kept inside this folder on purpose: never commit it
/archive/
/manual-backups/

# local notes and drafts that are not part of the project
/prompts/
/design-preview/
desktop.ini

# local list of values the privacy scan must refuse
/.privacy-blocklist
