{
  "name": "claude-chat-relocator",
  "version": "2.0.0",
  "description": "Read every Claude Code chat outside VS Code, keep all of them in a permanent archive, and bring back chats VS Code can no longer find after you move a project.",
  "keywords": [
    "claude",
    "claude-code",
    "anthropic",
    "vscode",
    "chat-history",
    "transcript",
    "jsonl",
    "export",
    "backup",
    "archive",
    "chat-archive"
  ],
  "homepage": "https://github.com/amirtavakolihaghighi/claude-chat-relocator#readme",
  "bugs": {
    "url": "https://github.com/amirtavakolihaghighi/claude-chat-relocator/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/amirtavakolihaghighi/claude-chat-relocator.git"
  },
  "license": "MIT",
  "author": "Amir Tavakoli Haghighi",
  "type": "commonjs",
  "main": "server/index.js",
  "bin": {
    "claude-chat-relocator": "server/index.js"
  },
  "files": [
    "server/",
    "public/",
    "docs/HELP.md",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "start": "node server/index.js",
    "dev": "node --watch server/index.js",
    "test": "node --test",
    "test:watch": "node --test --watch",
    "demo": "node scripts/demo-store.js",
    "check:ui": "node scripts/ui-check.js",
    "check:privacy": "node scripts/privacy-scan.js",
    "archive": "node server/vault-cli.js"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "adm-zip": "^0.5.16",
    "express": "^4.21.2",
    "highlight.js": "^11.11.1",
    "marked": "^15.0.7"
  }
}
